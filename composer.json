{
    "name": "yireo/magento2-devhacks",
    "version": "0.2.0",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "homepage": "https://github.com/yireo/Yireo_DevHacks",
    "description": "Some hacks to make M2 development easier",
    "keywords": [
        "composer-installer",
        "magento",
        "dev"
    ],
    "require": {
        "ext-pcre": "*",
        "magento/framework": "^100.0|^101.0|^102.0|^103.0",
        "magento/module-deploy": "^100.0",
        "magento/module-store": "^100.0|^101.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\DevHacks\\": ""
        },
        "files": [
            "registration.php"
        ]
    }
}